{
  "rules": {
    ".read": false,
    ".write": false,
    "nexus_users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || root.child('nexus_users').child(auth.uid).child('role').val() === 'ADMIN' || root.child('nexus_settings/permissions').child(root.child('nexus_users').child(auth.uid).child('role').val()).child('canManageUsers').val() === true)"
      },
      ".indexOn": ["username", "email"]
    },
    "nexus_invites": {
      ".read": "true",
      "$invite_id": {
        ".write": "auth != null && (!data.exists() ? (root.child('nexus_users').child(auth.uid).child('role').val() === 'ADMIN' || root.child('nexus_settings/permissions').child(root.child('nexus_users').child(auth.uid).child('role').val()).child('canManageUsers').val() === true) : true)"
      },
      ".indexOn": ["email"]
    },
    "nexus_settings": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('nexus_users').child(auth.uid).child('role').val() === 'ADMIN' || root.child('nexus_settings/permissions').child(root.child('nexus_users').child(auth.uid).child('role').val()).child('canManageSettings').val() === true)"
    },
    "nexus_stock": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('nexus_users').child(auth.uid).child('role').val() === 'ADMIN' || root.child('nexus_settings/permissions').child(root.child('nexus_users').child(auth.uid).child('role').val()).child('canManageStock').val() === true)"
    },
    "nexus_master": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('nexus_users').child(auth.uid).child('role').val() === 'ADMIN' || root.child('nexus_settings/permissions').child(root.child('nexus_users').child(auth.uid).child('role').val()).child('canManageStock').val() === true)"
    },
    "nexus_orders": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('nexus_users').child(auth.uid).child('role').val() === 'ADMIN' || root.child('nexus_settings/permissions').child(root.child('nexus_users').child(auth.uid).child('role').val()).child('canCreateOrder').val() === true)"
    },
    "nexus_receipts": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('nexus_users').child(auth.uid).child('role').val() === 'ADMIN' || root.child('nexus_settings/permissions').child(root.child('nexus_users').child(auth.uid).child('role').val()).child('canViewReceipts').val() === true)"
    },
    "nexus_transfers": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('nexus_users').child(auth.uid).child('role').val() === 'ADMIN' || root.child('nexus_settings/permissions').child(root.child('nexus_users').child(auth.uid).child('role').val()).child('canViewTransfers').val() === true)"
    },
    "nexus_purchase_orders": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('nexus_users').child(auth.uid).child('role').val() === 'ADMIN' || root.child('nexus_settings/permissions').child(root.child('nexus_users').child(auth.uid).child('role').val()).child('canCreatePurchaseOrder').val() === true)"
    },
    "nexus_public_usernames": {
      ".read": "true",
      ".write": "auth != null"
    }
  }
}
